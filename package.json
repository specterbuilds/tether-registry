{
  "name": "tether-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:sdk": "npm ci --prefix vendor/tether && npm run build --prefix vendor/tether",
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
