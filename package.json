    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.9.9",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "vite": "^7.1.3"
  }
}
